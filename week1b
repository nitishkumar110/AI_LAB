# Vacuum Cleaner Agent

rooms = {
    "A": "Dirty",
    "B": "Dirty"
}

current_room = "A"

def print_rooms():
    print("\nRoom Status:")
    print(f"Room A: {rooms['A']}")
    print(f"Room B: {rooms['B']}")
    print(f"Vacuum is currently in Room {current_room}\n")


def vacuum_cleaner():
    global current_room

    print("Starting Vacuum Cleaner...")
    print_rooms()

    while "Dirty" in rooms.values():

        if rooms[current_room] == "Dirty":
            print(f"Room {current_room} is dirty.")
            print(f"Cleaning Room {current_room}...")
            rooms[current_room] = "Clean"
            print(f"Room {current_room} is now clean.")

        else:
            if current_room == "A":
                current_room = "B"
            else:
                current_room = "A"

            print(f"Moving vacuum to Room {current_room}...")

        print_rooms()

    print("🎉 All rooms are clean!")
    print("Vacuum Cleaner stopped.")


vacuum_cleaner()
