import random

board = [" " for _ in range(9)]


def print_board():
    print()
    print(f" {board[0]} | {board[1]} | {board[2]} ")
    print("---+---+---")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("---+---+---")
    print(f" {board[6]} | {board[7]} | {board[8]} ")
    print()


def check_winner(player):
    winning_combinations = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),
        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),
        (0, 4, 8),
        (2, 4, 6)
    ]

    return any(
        board[a] == board[b] == board[c] == player
        for a, b, c in winning_combinations
    )


def bot_move():
    available_moves = []

    for i in range(9):
        if board[i] == " ":
            available_moves.append(i)

    move = random.choice(available_moves)
    board[move] = "O"

    print(f"Bot chose position {move + 1}")


def play_game():
    print("TIC-TAC-TOE")
    print("You are X")
    print("Bot is O")

    for turn in range(9):
        print_board()

        # Player's move
        while True:
            try:
                move = int(input("Player X, choose a position (1-9): "))

                if move < 1 or move > 9:
                    print("Please enter a number from 1 to 9.")

                elif board[move - 1] != " ":
                    print("That position is already taken.")

                else:
                    break

            except ValueError:
                print("Please enter a valid number.")

        board[move - 1] = "X"

        # Check if player wins
        if check_winner("X"):
            print_board()
            print("Player X wins!")
            return

        # Check draw
        if turn == 8:
            break

        # Bot's move
        bot_move()

        # Check if bot wins
        if check_winner("O"):
            print_board()
            print("Bot wins!")
            return

    print_board()
    print("It's a draw!")


play_game()
