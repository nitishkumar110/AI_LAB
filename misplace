print("\nEnter the INITIAL state.")
print("Use 0 for the blank space.")
print("Example: 1 2 3 4 0 6 7 5 8")

start = tuple(map(int, input("Initial state: ").split()))

print("\nEnter the GOAL state.")
print("Example: 1 2 3 4 5 6 7 8 0")

goal = tuple(map(int, input("Goal state: ").split()))


# Check input
if len(start) != 9 or len(goal) != 9:

    print("Error: Enter exactly 9 numbers.")
    exit()


if sorted(start) != sorted(goal):

    print("Error: Initial and goal states must contain the same numbers.")
    exit()


# Run A*
solution = a_star(start, goal)


# --------------------------------
# DISPLAY SOLUTION
# --------------------------------

if solution is None:

    print("\nNo solution found.")

else:

    print("\n========== OPTIMAL SOLUTION ==========")

    print("Number of moves:", len(solution) - 1)

    print()

    for step, (state, g, h, f) in enumerate(solution):

        print("Step", step)

        if step == 0:
            print("Move: START")
        else:
            print("Move: MOVE")

        print()

        print_puzzle(state)

        print()
        print("g =", g)
        print("h =", h)
        print("f = g + h =", f)

        print("----------------------------------")
