# Dynamic Input
# --------------------------------

n = int(input("Enter number of queens: "))

if n != 8:

    print("This program is designed for 8 queens.")

else:

    print("\nEnter 8 values representing queen positions.")
    print("Example: 0 1 2 3 4 5 6 7")

    initial_state = list(
        map(int, input("Enter initial state: ").split())
    )

    if len(initial_state) != 8:

        print("Error: Enter exactly 8 values.")

    elif sorted(initial_state) != list(range(8)):

        print("Error: Enter a permutation of 0 to 7.")

    else:

        simulated_annealing(initial_state)
